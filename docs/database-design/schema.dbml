Table venues {
  id uuid [pk]
  name varchar [not null]
  phone varchar [not null]
  address varchar
  latitude numeric(9,6)
  longitude numeric(9,6)
  opens_at time [note: 'if closes_at <= opens_at, closing is the next day']
  closes_at time
  last_synced_at timestamptz [note: 'set by backend on every sync call from the shop device, even empty ones']
  shop_device_id uuid [unique, note: 'the one device allowed to run this shop offline; backend accepts sync only from it']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table staff {
  id uuid [pk]
  name varchar [not null]
  phone varchar [not null, unique]
  password_hash varchar [not null]
  pin_hash varchar [note: 'short PIN for quick staff switching on the shop device']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table staff_venues {
  id uuid [pk]
  staff_id uuid [not null]
  venue_id uuid [not null]
  role varchar [not null, note: 'Owner | Manager | Staff']
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz

  indexes {
    (staff_id, venue_id) [unique]
  }
}

Table units {
  id uuid [pk]
  venue_id uuid [not null]
  room_id uuid [not null]
  name varchar [not null]
  status varchar [not null, default: 'Active', note: 'Active | Maintenance | Disabled']
  unit_type_id uuid [not null]
  price_category_id uuid [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table rooms {
  id uuid [pk]
  venue_id uuid [not null]
  name varchar [not null]
  room_group_id uuid [note: 'optional group on the Floor screen']
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table price_categories {
  id uuid [pk]
  venue_id uuid [not null]
  name varchar [not null]
  hourly_price numeric(10,2) [not null]
  multi_hourly_price numeric(10,2) [note: 'null = no multi mode (app does not ask single/multi)']
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table unit_types {
  // e.g. PS4, PS5, Ping Pong, Billiards
  id uuid [pk]
  name varchar [not null]
}

Table customers {
  id uuid [pk]
  name varchar [not null]
  phone varchar [not null, unique]
  password_hash varchar [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table walk_in_customers {
  id uuid [pk]
  venue_id uuid [not null]
  name varchar
  phone varchar
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table reservations {
  id uuid [pk]
  venue_id uuid [not null]
  customer_id uuid
  walk_in_customer_id uuid
  status varchar [not null, default: 'Pending', note: 'Pending | Confirmed | Rejected | Expired | Cancelled | Completed. Backend confirms instantly if shop online, else PC decides on sync']
  confirmation_code varchar [note: 'customer shows this (or its QR) at the shop']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  staff_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table reservations_units {
  id uuid [pk]
  reservation_id uuid [not null]
  unit_id uuid [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table products {
  id uuid [pk]
  venue_id uuid [not null]
  name varchar [not null]
  price numeric(10,2) [not null]
  stock_quantity integer [not null, default: 0, note: 'changed on the shop PC only (sales, restock); owner app shows it read-only']
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table sessions {
  id uuid [pk]
  venue_id uuid [not null]
  reservation_id uuid
  customer_id uuid
  walk_in_customer_id uuid
  status varchar [not null, default: 'Active', note: 'Active | Completed | Cancelled']
  staff_id uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table sessions_units {
  id uuid [pk]
  session_id uuid [not null]
  unit_id uuid [not null]
  started_at timestamptz [not null]
  ended_at timestamptz
  mode varchar [not null, note: 'Single | Multi']
  planned_minutes int [note: 'countdown length; null = open time. Reminder only, the bill is the time actually played']
  hourly_price numeric(10,2) [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table sessions_products {
  id uuid [pk]
  session_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null, default: 1]
  unit_price numeric(10,2) [not null]
  ordered_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table bills {
  id uuid [pk]
  venue_id uuid [not null]
  session_id uuid [note: 'null for a quick sale (no session)']
  subtotal numeric(10,2) [not null, note: 'before discount']
  discount numeric(10,2) [not null, default: 0]
  total numeric(10,2) [not null, note: 'after discount = amount actually paid']
  paid_at timestamptz
  staff_id uuid [not null]
  discount_note varchar
  shift_id uuid [not null]
  payment_method varchar [not null, note: 'Cash | Instapay | Wallet']
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table shifts {
  id uuid [pk]
  venue_id uuid [not null]
  opened_by_staff_id uuid [not null]
  opened_at timestamptz [not null]
  opening_cash numeric(10,2) [not null]
  closed_by_staff_id uuid
  closed_at timestamptz
  expected_cash numeric(10,2) [note: 'calculated at close, stored as snapshot']
  counted_cash numeric(10,2)
  note varchar
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table cash_movements {
  id uuid [pk]
  venue_id uuid [not null]
  shift_id uuid [not null]
  staff_id uuid [not null]
  type varchar [not null, note: 'Expense | CashIn | OwnerWithdrawal']
  amount numeric(10,2) [not null]
  note varchar
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}


Table remote_commands {
  id uuid [pk]
  venue_id uuid [not null]
  staff_id uuid [not null, note: 'who asked for it']
  device_id uuid [not null, note: 'which phone sent it']
  type varchar [not null, note: 'e.g. start_session; string so old devices can reject unknown types']
  payload jsonb [not null]
  status varchar [not null, default: 'Pending', note: 'Pending | Applied | Rejected | Expired']
  reject_reason varchar
  created_at timestamptz [not null]
  applied_at timestamptz
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table devices {
  id uuid [pk, note: 'created on the device at install']
  staff_id uuid [not null, note: 'who last logged in']
  venue_id uuid [note: 'null for an owner phone covering several venues']
  name varchar [not null]
  platform varchar [not null, note: 'Windows | Android | IOS | MacOS']
  app_version varchar
  last_seen_at timestamptz
  revoked_at timestamptz [note: 'lost/stolen: backend refuses login and sync']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid [note: 'who made the last change, incl. soft delete']
  deleted_at timestamptz
}

Table bill_items {
  id uuid [pk]
  bill_id uuid [not null]
  product_id uuid [note: 'null for play time']
  description varchar [not null, note: 'text on the receipt, e.g. Play time PS5-2']
  quantity integer [not null, default: 1]
  unit_price numeric(10,2) [not null]
  total numeric(10,2) [not null, note: 'quantity x unit_price']
  updated_at timestamptz [not null]
  updated_by_staff_id uuid
  deleted_at timestamptz
  Note: 'Receipt lines, copied at payment time and never changed afterwards'
}

Table room_groups {
  id uuid [pk]
  venue_id uuid [not null]
  name varchar [not null, note: 'e.g. الصالات']
  sort_order integer [not null, default: 0]
  updated_at timestamptz [not null]
  updated_by_staff_id uuid
  deleted_at timestamptz
  Note: 'Owner-made grouping of rooms for the Floor screen. Private rooms (one unit) are not grouped.'
}

Ref: units.room_id > rooms.id
Ref: units.price_category_id > price_categories.id
Ref: units.unit_type_id > unit_types.id
Ref: units.venue_id > venues.id
Ref: rooms.venue_id > venues.id
Ref: price_categories.venue_id > venues.id
Ref: reservations.venue_id > venues.id
Ref: reservations.customer_id > customers.id
Ref: reservations_units.reservation_id > reservations.id
Ref: reservations_units.unit_id > units.id
Ref: walk_in_customers.venue_id > venues.id
Ref: sessions.venue_id > venues.id
Ref: reservations.id - sessions.reservation_id
Ref: sessions.customer_id > customers.id
Ref: sessions.walk_in_customer_id > walk_in_customers.id
Ref: reservations.walk_in_customer_id > walk_in_customers.id
Ref: sessions_units.session_id > sessions.id
Ref: sessions_units.unit_id > units.id
Ref: sessions_products.session_id > sessions.id
Ref: sessions_products.product_id > products.id
Ref: bills.venue_id > venues.id
Ref: bills.session_id > sessions.id
Ref: staff_venues.staff_id > staff.id
Ref: staff_venues.venue_id > venues.id
Ref: sessions.staff_id > staff.id
Ref: bills.staff_id > staff.id
Ref: reservations.staff_id > staff.id
Ref: bills.shift_id > shifts.id
Ref: shifts.venue_id > venues.id
Ref: shifts.opened_by_staff_id > staff.id
Ref: shifts.closed_by_staff_id > staff.id
Ref: cash_movements.venue_id > venues.id
Ref: cash_movements.shift_id > shifts.id
Ref: cash_movements.staff_id > staff.id
Ref: remote_commands.venue_id > venues.id
Ref: remote_commands.staff_id > staff.id
Ref: remote_commands.device_id > devices.id
Ref: devices.staff_id > staff.id
Ref: devices.venue_id > venues.id
Ref: venues.shop_device_id > devices.id
Ref: bill_items.bill_id > bills.id
Ref: bill_items.product_id > products.id
Ref: rooms.room_group_id > room_groups.id
Ref: room_groups.venue_id > venues.id
